@using SkillSwapBD.Models
@{
    ViewData["Title"] = "Swap Requests";
    var incoming = (List<SwapRequest>)ViewBag.Incoming;
    var outgoing = (List<SwapRequest>)ViewBag.Outgoing;
}

<div class="container py-4">
    <div class="alert alert-info">
        <strong>DEBUG:</strong> Logged in as user Id = @ViewBag.DebugUserId (@User.Identity?.Name)
    </div>

    <h1 class="mb-4">Swap Requests</h1>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#incoming" type="button">
                Incoming <span class="badge bg-secondary">@incoming.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#outgoing" type="button">
                Outgoing <span class="badge bg-secondary">@outgoing.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content pt-4">
        <div class="tab-pane fade show active" id="incoming">
            @if (!incoming.Any())
            {
                <p class="text-muted">No incoming swap requests yet.</p>
            }
            @foreach (var sr in incoming)
            {
                <div class="card mb-3 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@sr.Requester?.FullName</strong> wants your
                            <em>@sr.ReceiverSkill?.Title</em> in exchange for their
                            <em>@sr.RequesterSkill?.Title</em>.
                            <div class="text-muted small">Status: <span class="badge bg-info text-dark">@sr.Status</span></div>
                        </div>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@sr.Id">View</a>
                    </div>
                </div>
            }
        </div>
        <div class="tab-pane fade" id="outgoing">
            @if (!outgoing.Any())
            {
                <p class="text-muted">You haven't sent any swap requests yet.</p>
            }
            @foreach (var sr in outgoing)
            {
                <div class="card mb-3 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            You offered <em>@sr.RequesterSkill?.Title</em> for
                            <strong>@sr.Receiver?.FullName</strong>'s <em>@sr.ReceiverSkill?.Title</em>.
                            <div class="text-muted small">Status: <span class="badge bg-info text-dark">@sr.Status</span></div>
                        </div>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@sr.Id">View</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>