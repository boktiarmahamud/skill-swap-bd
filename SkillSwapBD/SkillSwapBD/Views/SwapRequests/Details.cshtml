@using SkillSwapBD.Models
@using static SkillSwapBD.Models.Enums
@model SwapRequest
@{
    ViewData["Title"] = "Swap Request Details";
}
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

@{
    var myId = UserManager.GetUserId(User);
    var isReceiver = Model.ReceiverId == myId;
    var isRequester = Model.RequesterId == myId;
}

<div class="container py-4" style="max-width: 700px;">
    <h1 class="mb-4">Swap Request</h1>

    <div class="card p-4 mb-4">
        <div class="row">
            <div class="col-6">
                <h6 class="text-muted">Requester offers</h6>
                <p><strong>@Model.Requester?.FullName</strong></p>
                <p>@Model.RequesterSkill?.Title</p>
            </div>
            <div class="col-6">
                <h6 class="text-muted">In exchange for</h6>
                <p><strong>@Model.Receiver?.FullName</strong></p>
                <p>@Model.ReceiverSkill?.Title</p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <hr />
            <p><em>"@Model.Message"</em></p>
        }
        <hr />
        <p>Status: <span class="badge bg-info text-dark">@Model.Status</span></p>
    </div>

    <div class="d-flex gap-2">
        @if (Model.Status == SwapStatus.Pending && isReceiver)
        {
            <form asp-action="Accept" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">Accept</button>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-danger">Reject</button>
            </form>
        }
        @if (Model.Status == SwapStatus.Pending && isRequester)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary">Cancel Request</button>
            </form>
        }
        @if (Model.Status == SwapStatus.Accepted)
        {
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">Mark as Completed</button>
            </form>
        }
        @if (Model.Status == SwapStatus.Completed)
        {
            <span class="text-success fw-bold align-self-center">✅ Swap completed</span>
        }
    </div>

    <a asp-action="Index" class="btn btn-link mt-3">&larr; Back to Swap Requests</a>
</div>