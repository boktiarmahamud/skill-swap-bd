@using static SkillSwapBD.Models.Enums
@model List<Skill>
@{
    ViewData["Title"] = "Home";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1>Skill Swap BD</h1>
        <p class="text-muted">Trade skills with others instead of paying money.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Skills" asp-action="Index">Browse Skills</a>
            <a class="btn btn-outline-primary" asp-controller="Skills" asp-action="Create">+ Post a Skill</a>
        </div>
        <p class="text-muted mt-2 small">@ViewBag.SkillCount skills posted &middot; @ViewBag.UserCount approved members</p>
    </div>

    <h4 class="mb-3">Recently Posted</h4>
    <div class="row g-4">
        @foreach (var skill in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge @(skill.Type == SkillType.Offer ? "bg-success" : "bg-warning text-dark")">
                            @(skill.Type == SkillType.Offer ? "Offering" : "Wanted")
                        </span>
                        <h5 class="card-title mt-2">@skill.Title</h5>
                        <p class="text-muted small">@skill.Category?.Name &middot; by @skill.User?.FullName</p>
                        <p>@skill.Description</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Skills" asp-action="Details" asp-route-id="@skill.Id">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted">No skills posted yet — be the first!</p>
    }
</div>