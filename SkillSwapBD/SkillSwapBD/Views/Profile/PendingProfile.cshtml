@using SkillSwapBD.Models
@model ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="profile-card">
                <div class="profile-cover"></div>
                <div class="p-4 text-center">
                    <div class="profile-avatar-wrap">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" class="profile-avatar" alt="Profile photo" />
                        }
                        else
                        {
                            <div class="avatar-circle">@Model.FullName.Substring(0, 1).ToUpper()</div>
                        }
                    </div>

                    <h4 class="profile-name mt-3">@Model.FullName</h4>
                    <p class="profile-location mb-3">📍 @Model.Location</p>

                    <div class="alert alert-warning">
                        ⏳ Your account is pending admin approval.<br />
                        Once approved, your profile, skills, and reviews will be visible.
                    </div>

                    <a class="btn btn-edit-profile btn-sm mt-2" asp-action="Edit">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>