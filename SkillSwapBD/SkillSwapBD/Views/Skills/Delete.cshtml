@model Skill
@{
    ViewData["Title"] = "Delete Skill";
}

<div class="container py-4" style="max-width: 640px;">
    <h1 class="mb-4 text-danger">Delete Skill</h1>
    <p>Are you sure you want to delete this skill post?</p>

    <div class="card p-3 mb-3">
        <h5>@Model.Title</h5>
        <p class="text-muted mb-0">@Model.Category?.Name</p>
        <p>@Model.Description</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="MySkills" class="btn btn-link">Cancel</a>
    </form>
</div>