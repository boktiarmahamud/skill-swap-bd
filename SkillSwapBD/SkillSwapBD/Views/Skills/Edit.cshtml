@using SkillSwapBD.ViewModels
@using static SkillSwapBD.Models.Enums
@model SkillFormViewModel
@{
    ViewData["Title"] = "Edit Skill";
}

<link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

<div class="container py-4">
    <div class="form-card">
        <div class="form-card-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 20h9M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4 12.5-12.5z" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <h1 class="form-card-title h4">Edit Skill</h1>
        <p class="form-card-subtitle">Update the details of your posted skill</p>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<SkillType>()"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                @if (!string.IsNullOrEmpty(Model.ExistingAttachmentUrl))
                {
                    <div class="current-file-box">
                        📎 Current file: <a href="@Model.ExistingAttachmentUrl" target="_blank">View attachment</a>
                    </div>
                }
                <label class="form-label">Replace Photo/Document (optional)</label>
                <input asp-for="Attachment" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx" />
                <div class="file-drop-hint">📁 JPG, PNG, WEBP, PDF, or DOC — max 5MB.</div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button type="submit" class="btn btn-publish">Save Changes</button>
                <a asp-action="MySkills" class="btn-cancel-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}