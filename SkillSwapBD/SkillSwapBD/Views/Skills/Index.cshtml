@using SkillSwapBD.ViewModels
@using static SkillSwapBD.Models.Enums
@model SkillListViewModel
@{
    ViewData["Title"] = "Browse Skills";
}

<link rel="stylesheet" href="~/css/browse-skills.css" asp-append-version="true" />

<div class="container py-4">
    <div class="browse-header">
        <h1 class="browse-title h3">Browse Skills</h1>
    </div>

    <form method="get" class="filter-bar row g-2">
        <div class="col-md-4">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="🔍 Search skills..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<SkillType>()">
                <option value="">Offering &amp; Wanted</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-filter">Filter</button>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var skill in Model.Skills)
        {
            <div class="col-md-4">
                <div class="browse-card">
                    <div class="browse-card-body">
                        <span class="type-badge @(skill.Type == SkillType.Offer ? "bg-success text-white" : "bg-warning text-dark")">
                            @(skill.Type == SkillType.Offer ? "Offering" : "Wanted")
                        </span>
                        <h5 class="browse-card-title">@skill.Title</h5>
                        <p class="browse-card-meta">@skill.Category?.Name &middot; by @skill.User?.FullName</p>
                        <p class="browse-card-desc">@skill.Description</p>
                    </div>
                    <div class="browse-card-footer">
                        <a class="btn-view-details" asp-action="Details" asp-route-id="@skill.Id">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Skills.Any())
    {
        <div class="empty-browse-box">
            <p class="mb-0">No skills matched your search. Try adjusting your filters.</p>
        </div>
    }
</div>